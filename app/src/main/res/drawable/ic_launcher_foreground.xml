<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 黑曜石内圈徽章底座 -->
    <path
        android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z"
        android:strokeColor="#38FFFFFF"
        android:strokeWidth="1.2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="78"
                android:endY="82"
                android:startX="30"
                android:startY="26"
                android:type="linear">
                <item
                    android:color="#FF1E242E"
                    android:offset="0.0" />
                <item
                    android:color="#FF090B0F"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 液态银白双轨断弧 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,26 A28,28 0 0,1 82,54"
        android:strokeLineCap="round"
        android:strokeWidth="2.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="82"
                android:endY="54"
                android:startX="54"
                android:startY="26"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#99CBD5E1"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#00000000"
        android:pathData="M54,82 A28,28 0 0,1 26,54"
        android:strokeColor="#6694A3B8"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />

    <!-- 建筑感极简铂银字母 I -->
    <path android:pathData="M42.5,35.5 H65.5 V41.5 H57.5 V66.5 H65.5 V72.5 H42.5 V66.5 H50.5 V41.5 H42.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="64"
                android:endY="73"
                android:startX="44"
                android:startY="35"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#FFD8E1EC"
                    android:offset="0.6" />
                <item
                    android:color="#FF94A3B8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
